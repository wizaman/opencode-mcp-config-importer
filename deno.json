{
  "preferPackageJson": true,
  "test": {
    "include": ["tests/"]
  },
  "tasks": {
    "check": "deno check src tests scripts",
    "test": "deno test --allow-read --allow-write --allow-env=ADAPTER_ENV_HEADER_PROBE",
    "smoke:remote": "deno run -A scripts/smoke-remote.ts",
    "smoke:codex-headers": "deno run -A scripts/smoke-codex-headers.ts",
    "smoke:codex-env-headers": "deno run -A scripts/smoke-codex-env-headers.ts",
    "remote:serve": "deno run -A --no-config --node-modules-dir=none npm:@modelcontextprotocol/server-everything/dist/index.js streamableHttp",
    "oauth:serve": "deno run -A scripts/serve-oauth.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check src tests scripts package.json deno.json .mcp.json opencode.jsonc"
  }
}
